@model IEnumerable<CommunitySportsBooking.Models.Booking>
@{
    ViewData["Title"] = "My Facility Bookings";
}

<div class="py-4" style="background-color: var(--field-cream); min-height: 85vh;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="field-badge-orange">Reservations</span>
                <h2 class="fw-bold text-dark mt-1 mb-0" style="font-size: 1.8rem;">My Facility Bookings</h2>
                <p class="text-muted small">Manage your upcoming and past municipal sports bookings</p>
            </div>
            <a asp-controller="Facilities" asp-action="Index" class="btn btn-field-orange">
                <i class="bi bi-plus-lg me-1"></i> Book Another Facility
            </a>
        </div>

        @if (Model.Any())
        {
            <div class="field-card p-0 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: var(--field-green); color: #ffffff;">
                            <tr>
                                <th class="py-3 px-4">Facility Name</th>
                                <th class="py-3">Date</th>
                                <th class="py-3">Time Slot</th>
                                <th class="py-3">Total Price</th>
                                <th class="py-3">Status</th>
                                <th class="py-3 px-4 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                <tr>
                                    <td class="px-4">
                                        <strong class="text-dark">@b.Facility?.Name</strong><br />
                                        <small class="text-muted">@b.Facility?.FacilityType — @b.Facility?.Location</small>
                                    </td>
                                    <td>@b.BookingDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="field-badge">@b.TimeSlot</span></td>
                                    <td><strong class="price-lkr">Rs. @b.TotalPrice.ToString("N0")</strong></td>
                                    <td>
                                        @if (b.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Confirmed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@b.Status</span>
                                        }
                                    </td>
                                    <td class="px-4 text-end">
                                        @if (b.Status == "Confirmed")
                                        {
                                            <form asp-action="Cancel" asp-route-id="@b.BookingId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-2">Cancel</button>
                                            </form>
                                        }
                                        <a asp-controller="Reviews" asp-action="Create" asp-route-facilityId="@b.FacilityId" class="btn btn-field-outline-dark btn-sm rounded-2 ms-1">
                                            Review
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="field-card p-5 text-center">
                <i class="bi bi-calendar-x display-3 text-muted"></i>
                <h4 class="mt-3 text-dark">No Bookings Found</h4>
                <p class="text-muted">You haven't scheduled any facility bookings yet.</p>
                <div>
                    <a asp-controller="Facilities" asp-action="Index" class="btn btn-field-orange">Browse Sports Venues</a>
                </div>
            </div>
        }
    </div>
</div>
