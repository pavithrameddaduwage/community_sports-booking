@model CommunitySportsBooking.Models.Member
@{
    ViewData["Title"] = "Member Profile";
}

<div class="py-4" style="background-color: var(--field-cream); min-height: 85vh;">
    <div class="container">
        <div class="field-card p-4 mb-4">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-circle text-white display-6" style="background-color: var(--field-green);">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div>
                    <span class="field-badge-orange">Member Profile</span>
                    <h2 class="fw-bold text-dark mb-1">@Model.FullName</h2>
                    <p class="text-muted mb-0"><i class="bi bi-envelope me-1"></i>@Model.Email | <i class="bi bi-telephone me-1"></i>@Model.ContactNumber</p>
                    <small class="badge bg-success mt-1">@Model.Role</small>
                </div>
            </div>
            <hr class="my-3" style="border-color: var(--field-border);" />
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-1 text-secondary"><strong>Address:</strong> @Model.Address</p>
                </div>
                <div class="col-md-6">
                    <p class="mb-1 text-secondary"><strong>Preferred Sports:</strong> <span class="field-badge">@Model.PreferredSports</span></p>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="field-card h-100 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-calendar-event me-2 text-warning"></i>My Bookings History</h5>
                        <a asp-controller="Bookings" asp-action="MyBookings" class="btn btn-sm btn-field-outline-dark">View All</a>
                    </div>
                    @if (Model.Bookings.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var b in Model.Bookings.Take(5))
                            {
                                <li class="list-group-item px-0 d-flex justify-content-between align-items-center bg-transparent">
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark">@b.Facility?.Name</h6>
                                        <small class="text-muted">@b.BookingDate.ToString("yyyy-MM-dd") (@b.TimeSlot)</small>
                                    </div>
                                    <span class="badge @(b.Status == "Confirmed" ? "bg-success" : "bg-secondary")">@b.Status</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">No bookings made yet.</p>
                    }
                </div>
            </div>

            <div class="col-md-6">
                <div class="field-card h-100 p-4">
                    <div class="mb-3">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-star-fill me-2 text-warning"></i>My Reviews &amp; Ratings</h5>
                    </div>
                    @if (Model.Reviews.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var r in Model.Reviews)
                            {
                                <li class="list-group-item px-0 bg-transparent">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="mb-1 fw-bold text-dark">@r.Facility?.Name</h6>
                                        <div class="star-rating text-warning small">
                                            @for (int i = 0; i < r.Rating; i++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                        </div>
                                    </div>
                                    <p class="small text-secondary mb-0">"@r.Comment"</p>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">No reviews submitted yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
